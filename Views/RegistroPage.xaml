<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="scaldasExamen.Views.RegistroPage"
             Title="Registro"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25">

            <!-- Usuario conectado -->
            <Label x:Name="lblUsuarioConectado"
                   Style="{StaticResource LabelStyle}"
                   HorizontalOptions="End" />

            <!-- Título -->
            <Label Text="REGISTRO"
                   TextColor="Blue"
                   FontSize="22"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold" />

            <!-- GRID -->
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,*,*"
                  RowSpacing="8"
                  ColumnSpacing="8">

                <Label Grid.Row="0" Grid.Column="0" Text="Nombre"
                       Style="{StaticResource LabelStyle}" />
                <Label Grid.Row="0" Grid.Column="1" Text="Apellido"
                       Style="{StaticResource LabelStyle}" />
                <Label Grid.Row="0" Grid.Column="2" Text="Voltiamperio VA"
                       Style="{StaticResource LabelStyle}" />

                <Entry Grid.Row="1" Grid.Column="0"
                       x:Name="entryNombre"
                       Placeholder="Nombre"
                       Style="{StaticResource EntryStyle}" />
                <Entry Grid.Row="1" Grid.Column="1"
                       x:Name="entryApellido"
                       Placeholder="Apellido"
                       Style="{StaticResource EntryStyle}" />
                <Picker Grid.Row="1" Grid.Column="2"
                        x:Name="pickerVA"
                        Title="Seleccionar VA">
                    <Picker.Items>
                        <x:String>500</x:String>
                        <x:String>750</x:String>
                        <x:String>1000</x:String>
                    </Picker.Items>
                </Picker>

            </Grid>

            <!-- GRID 2-->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*"
                  RowSpacing="10"
                  ColumnSpacing="10">

                <Label Grid.Row="0" Grid.Column="0" Text="Fecha"
                       Style="{StaticResource LabelStyle}" VerticalOptions="Center" />
                <DatePicker Grid.Row="0" Grid.Column="1"
                            x:Name="datePicker"
                            Format="dd/MM/yyyy" />

                <Label Grid.Row="1" Grid.Column="0" Text="Ciudad"
                       Style="{StaticResource LabelStyle}" VerticalOptions="Center" />
                <Picker Grid.Row="1" Grid.Column="1"
                        x:Name="pickerCiudad"
                        Title="Seleccionar ciudad">
                    <Picker.Items>
                        <x:String>Quito</x:String>
                        <x:String>Guayaquil</x:String>
                        <x:String>Cuenca</x:String>
                        <x:String>Ambato</x:String>
                        <x:String>Loja</x:String>
                        <x:String>Manta</x:String>
                    </Picker.Items>
                </Picker>

                <Label Grid.Row="2" Grid.Column="0" Text="Monto Inicial"
                       Style="{StaticResource LabelStyle}" VerticalOptions="Center" />
                <Entry Grid.Row="2" Grid.Column="1"
                       x:Name="entryMontoInicial"
                       Placeholder="Monto inicial"
                       IsReadOnly="True"
                       Style="{StaticResource EntryStyle}" />

                <Button Grid.Row="3" Grid.Column="0"
                        Text="Calcular Pago mensual"
                        Clicked="OnCalcularClicked"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Entry Grid.Row="3" Grid.Column="1"
                       x:Name="entryCuotaMensual"
                       Placeholder="Cuota mensual"
                       IsReadOnly="True"
                       Style="{StaticResource EntryStyle}" />

            </Grid>

            <!-- Botón Ver Resumen  -->
            <Button Text="Ver Resumen"
                    Clicked="OnVerResumenClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
