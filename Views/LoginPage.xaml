<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="scaldasExamen.Views.LoginPage"
             Title="Login"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25">

            <!-- Logo empresa (imagen local) -->
            <Image Source="logo.jpg"
                   HeightRequest="120"
                   WidthRequest="120"
                   HorizontalOptions="Center" />

            <!-- Título -->
            <Label Text="Sistema UPS - Iniciar Sesión"
                   TextColor="Red"
                   FontSize="20"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold" />

            <!-- GRID 3 filas x 2 columnas -->
            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,*"
                  RowSpacing="12"
                  ColumnSpacing="10">

                <Label Grid.Row="0" Grid.Column="0"
                       Text="Usuario"
                       Style="{StaticResource LabelStyle}" />
                <Label Grid.Row="0" Grid.Column="1"
                       Text="Contraseña"
                       Style="{StaticResource LabelStyle}" />

                <Entry Grid.Row="1" Grid.Column="0"
                       x:Name="entryUsuario"
                       Placeholder="Ingrese usuario"
                       Style="{StaticResource EntryStyle}" />
                <Entry Grid.Row="1" Grid.Column="1"
                       x:Name="entryPassword"
                       Placeholder="Ingrese contraseña"
                       IsPassword="True"
                       Style="{StaticResource EntryStyle}" />

                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="Iniciar Sesión"
                        Clicked="OnIniciarSesionClicked"
                        Style="{StaticResource PrimaryButtonStyle}" />

            </Grid>

            <!-- Botón Acerca de -->
            <Button Text="Acerca de"
                    Clicked="OnAcercaDeClicked"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
